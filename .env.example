# Mot de passe partage pour se connecter a l'application
APP_PASSWORD=change-moi

# Optionnel : mot de passe du tableau de bord admin. Si absent, APP_PASSWORD
# donne aussi acces a l'admin. Si present, APP_PASSWORD ne donne plus acces
# qu'a l'app jockey.
ADMIN_PASSWORD=

# Secret aleatoire pour signer les sessions (genere avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=change-moi-aussi

# Optionnel en local : si absent, une base SQLite locale (data/local.db) est utilisee.
# En production (Render), renseigner les identifiants de la base Turso.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
